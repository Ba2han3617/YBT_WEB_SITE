@{
    ViewData["Title"] = "İletişim";
}

<section class="py-5 mt-5">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <span class="section-tag">Bize Ulaşın</span>
            <h1 class="display-4 fw-extrabold gradient-text">İletişim</h1>
            <p class="lead text-secondary fs-5">Fikirleriniz, iş birliği teklifleriniz veya sorularınız için bize her zaman ulaşabilirsiniz.</p>
        </div>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success bg-opacity-25 text-info border border-info border-opacity-25 rounded-pill px-4 reveal mb-4">
                @TempData["Message"]
            </div>
        }

        <div class="row g-5">
            <div class="col-lg-6 reveal">
                <div class="card p-4 p-md-5 border-0 shadow-lg">
                    <h3 class="fw-bold text-white mb-4"><i class="bi bi-send me-2 text-info"></i>Mesaj Gönderin</h3>
                    <form asp-action="SendMessage" method="post">
                        <div class="mb-3">
                            <label class="form-label text-secondary small">Adınız</label>
                            <input type="text" class="form-control rounded-pill px-4" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small">E-posta</label>
                            <input type="email" class="form-control rounded-pill px-4" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small">Konu</label>
                            <input type="text" class="form-control rounded-pill px-4" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-secondary small">Mesajınız</label>
                            <textarea class="form-control p-4" style="border-radius: 20px;" rows="4" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold"><i class="bi bi-paperplane me-2"></i>Gönder</button>
                    </form>
                </div>
            </div>
            <div class="col-lg-6 reveal">
                <div class="card p-4 p-md-5 border-0 mb-4">
                    <h4 class="fw-bold text-white mb-4"><i class="bi bi-geo-alt me-2 text-info"></i>İletişim Kanalları</h4>
                    <div class="d-flex align-items-center mb-4">
                        <div class="feature-icon-box mb-0 me-3" style="width: 48px; height: 48px; font-size: 1.2rem;">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>
                        <div>
                            <span class="text-secondary small d-block">Adres</span>
                            <span class="fs-6 text-white font-monospace">Düzce Üniversitesi Mühendislik Fakültesi / YBT Odası</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mb-4">
                        <div class="feature-icon-box mb-0 me-3" style="width: 48px; height: 48px; font-size: 1.2rem;">
                            <i class="bi bi-envelope-fill"></i>
                        </div>
                        <div>
                            <span class="text-secondary small d-block">E-posta</span>
                            <span class="fs-6 text-white font-monospace">yazilimvebilisimtoplulugu@gmail.com</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="feature-icon-box mb-0 me-3" style="width: 48px; height: 48px; font-size: 1.2rem;">
                            <i class="bi bi-chat-dots-fill"></i>
                        </div>
                        <div>
                            <span class="text-secondary small d-block">Sosyal Medya</span>
                            <span class="fs-6 text-white font-monospace">@@du.yazilim & @@ybt1881</span>
                        </div>
                    </div>
                </div>
                <div class="rounded-4 overflow-hidden border border-secondary border-opacity-25 shadow-lg" style="height: 250px;">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3009.626773229712!2d31.17387337651034!3d40.90091392525164!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x409d7509cf6e3599%3A0xb36ef8f2c3eb39ad!2sD%C3%BCzce%20%C3%9Cniversitesi!5e0!3m2!1str!2str!4v1700000000000!5m2!1str!2str" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                </div>
            </div>
        </div>
    </div>
</section>
