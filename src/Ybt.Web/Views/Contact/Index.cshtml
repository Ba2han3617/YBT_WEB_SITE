@{
    ViewData["Title"] = "İletişim";
}

<section class="py-5 mt-5">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <h1 class="display-4 fw-bold">İletişim</h1>
            <p class="lead text-secondary">Bize her zaman ulaşabilirsiniz.</p>
        </div>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success rounded-pill px-4 reveal">
                @TempData["Message"]
            </div>
        }

        <div class="row g-5">
            <div class="col-lg-6 reveal">
                <div class="card p-4 p-md-5 border-0 shadow-sm glass-card">
                    <h3 class="fw-bold mb-4">Mesaj Gönderin</h3>
                    <form asp-action="SendMessage" method="post">
                        <div class="mb-3">
                            <label class="form-label">Adınız</label>
                            <input type="text" class="form-control rounded-pill px-4" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control rounded-pill px-4" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Konu</label>
                            <input type="text" class="form-control rounded-pill px-4" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Mesajınız</label>
                            <textarea class="form-control rounded-4 p-4" rows="5" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold">Gönder</button>
                    </form>
                </div>
            </div>
            <div class="col-lg-6 reveal">
                <div class="mb-5">
                    <h4 class="fw-bold mb-4">İletişim Bilgileri</h4>
                    <div class="d-flex mb-3">
                        <i class="bi bi-geo-alt-fill text-primary fs-4 me-3"></i>
                        <p class="fs-5 text-secondary">Teknoloji Kampüsü, No: 42, İstanbul</p>
                    </div>
                    <div class="d-flex mb-3">
                        <i class="bi bi-envelope-fill text-primary fs-4 me-3"></i>
                        <p class="fs-5 text-secondary">info@ybt.com</p>
                    </div>
                    <div class="d-flex">
                        <i class="bi bi-telephone-fill text-primary fs-4 me-3"></i>
                        <p class="fs-5 text-secondary">+90 (212) 123 45 67</p>
                    </div>
                </div>
                <div class="rounded-5 overflow-hidden shadow-sm border" style="height: 350px;">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d192639.1931553754!2d28.817492931189215!3d41.00550050853503!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14caa7040068086b%3A0xe1cc1e01f4ca7d3e!2s%C4%B0stanbul!5e0!3m2!1str!2str!4v1700000000000!5m2!1str!2str" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                </div>
            </div>
        </div>
    </div>
</section>
