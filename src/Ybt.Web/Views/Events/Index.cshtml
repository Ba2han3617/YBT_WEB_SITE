@model IEnumerable<Ybt.Core.Entities.Event>
@{
    ViewData["Title"] = "Etkinlikler";
}

<section class="py-5 mt-5">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <span class="section-tag">YBT Etkinlik Takvimi</span>
            <h1 class="display-4 fw-extrabold gradient-text">Etkinlikler</h1>
            <p class="lead text-secondary fs-5">Teknoloji tutkunları için düzenlenen workshop, hackathon ve zirveler.</p>
        </div>
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-4 reveal">
                    <div class="card h-100 border-0 overflow-hidden">
                        <img src="@(item.ImageUrl ?? "https://images.unsplash.com/photo-1540575861501-7ad05823c9f5?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80")" class="card-img-top" alt="@item.Title" style="height: 220px; object-fit: cover;">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge bg-info bg-opacity-25 text-info px-3 py-2 border border-info border-opacity-25 rounded-pill"><i class="bi bi-rocket me-1"></i> Etkinlik</span>
                                    <small class="text-secondary font-monospace"><i class="bi bi-calendar3 me-1 text-primary"></i> @item.EventDate.ToString("dd MMM yyyy")</small>
                                </div>
                                <h4 class="fw-bold text-white mb-3">@item.Title</h4>
                                <p class="text-secondary mb-4 small">@(item.Description?.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)</p>
                            </div>
                            <a asp-action="Details" asp-route-slug="@item.Slug" class="btn btn-outline-primary w-100 rounded-pill"><i class="bi bi-arrow-right-circle me-2"></i>Detayları Gör</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
