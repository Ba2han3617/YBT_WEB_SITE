@model Ybt.Core.Entities.Event
@{
    ViewData["Title"] = Model?.Title ?? "Etkinlik Detayı";
    ViewData["Description"] = Model?.Description != null && Model.Description.Length > 150 ? Model.Description[..150] + "..." : Model?.Description;
    var userApplication = ViewBag.UserApplication as Ybt.Core.Entities.EventApplication;
    var applicationsCount = ViewBag.ApplicationsCount != null ? (int)ViewBag.ApplicationsCount : 0;
    var isPast = Model != null && Model.EventDate < DateTime.UtcNow;
}

<section class="events-hero-section" aria-label="Etkinlik Detayı">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="hero-ambient-l" aria-hidden="true"></div>
    <div class="hero-ambient-r" aria-hidden="true"></div>

    <div class="container position-relative z-2">
        <div class="row justify-content-center">
            <div class="col-lg-10 reveal">
                
                <!-- Geri Dön Bağlantısı -->
                <div class="mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Tüm Etkinliklere Dön
                    </a>
                    @if (isPast)
                    {
                        <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-25 px-3 py-2 rounded-pill">
                            <i class="bi bi-clock-history me-1"></i> Bu Etkinlik Tamamlandı
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">
                            <i class="bi bi-lightning-charge me-1"></i> Kayıtlar Açık
                        </span>
                    }
                </div>

                <!-- Detay Kartı -->
                <div class="event-detail-card">
                    @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Title" class="event-detail-cover" />
                    }

                    <div class="p-4 p-md-5">
                        <!-- Kategori ve Üst Rozetler -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                            <span class="badge bg-info bg-opacity-25 text-info px-3 py-2 border border-info border-opacity-25 rounded-pill">
                                <i class="bi bi-tag-fill me-1"></i> @(string.IsNullOrEmpty(Model?.Category) ? "Topluluk Etkinliği" : Model.Category)
                            </span>
                            @if (Model != null)
                            {
                                <span class="text-info font-monospace small">
                                    <i class="bi bi-calendar3 me-1"></i> @Model.EventDate.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")
                                </span>
                            }
                        </div>

                        <h1 class="display-6 fw-bold text-white mb-4">@Model?.Title</h1>

                        <!-- Key Highlights Grid -->
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6 col-md-3">
                                <div class="event-highlight-box">
                                    <i class="bi bi-calendar-event text-info fs-3 d-block mb-1"></i>
                                    <span class="text-secondary small d-block mb-1">Tarih &amp; Saat</span>
                                    <strong class="text-white small font-monospace">@Model?.EventDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="event-highlight-box">
                                    <i class="bi bi-geo-alt text-info fs-3 d-block mb-1"></i>
                                    <span class="text-secondary small d-block mb-1">Konum / Format</span>
                                    <strong class="text-white small">@(string.IsNullOrEmpty(Model?.Location) ? "Düzce Üniversitesi" : Model.Location)</strong>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="event-highlight-box">
                                    <i class="bi bi-people text-purple fs-3 d-block mb-1"></i>
                                    <span class="text-secondary small d-block mb-1">Kontenjan / Başvuru</span>
                                    <strong class="text-white small">
                                        @(Model?.Capacity.HasValue == true ? $"{applicationsCount} / {Model.Capacity} Kişi" : $"{applicationsCount} Başvuru")
                                    </strong>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="event-highlight-box">
                                    <i class="bi bi-person-badge text-teal fs-3 d-block mb-1"></i>
                                    <span class="text-secondary small d-block mb-1">Konuşmacı / Eğitmen</span>
                                    <strong class="text-white small">@(string.IsNullOrEmpty(Model?.Speaker) ? "YBT Ekibi" : Model.Speaker)</strong>
                                </div>
                            </div>
                        </div>

                        <hr class="border-secondary border-opacity-25 my-4" />

                        <!-- Etkinlik Açıklaması -->
                        <h4 class="fw-bold text-white mb-3"><i class="bi bi-info-circle text-info me-2"></i>Etkinlik Detayları</h4>
                        <div class="text-secondary fs-6 mb-5" style="white-space: pre-line; line-height: 1.8; color: #cbd5e1 !important;">
                            @Model?.Description
                        </div>

                        <!-- Başvuru Durum Paneli -->
                        @if (userApplication != null)
                        {
                            <div class="event-status-alert mb-4">
                                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="bi bi-check-circle-fill text-success fs-1"></i>
                                        <div>
                                            <h6 class="fw-bold text-white mb-1">Bu Etkinliğe Başvurunuz Bulunmaktadır</h6>
                                            <span class="text-secondary small d-block">
                                                Başvuru Tarihi: @userApplication.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") &bull; Durum: 
                                                <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-25 ms-1">@userApplication.Status</span>
                                            </span>
                                        </div>
                                    </div>
                                    <a asp-controller="Account" asp-action="Applications" class="btn btn-success rounded-pill px-4 shadow">
                                        <i class="bi bi-journal-check me-1"></i>Başvurularımı Gör
                                    </a>
                                </div>
                            </div>
                        }

                        <!-- Alt Butonlar -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-3 border-top border-secondary border-opacity-25">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="bi bi-arrow-left me-1"></i>Listeye Dön
                            </a>

                            @if (userApplication == null && !isPast)
                            {
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <button type="button" class="btn btn-primary rounded-pill px-5 py-2 shadow-lg fw-bold" data-bs-toggle="modal" data-bs-target="#applyEventModal">
                                        <i class="bi bi-ticket-perforated me-2"></i>Etkinliğe Başvur
                                    </button>
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Events/Details/@Model?.Slug" class="btn btn-primary rounded-pill px-5 py-2 shadow-lg fw-bold">
                                        <i class="bi bi-box-arrow-in-right me-2"></i>Başvurmak İçin Giriş Yap
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- Apply Event Modal -->
@if (Model != null && User.Identity?.IsAuthenticated == true && userApplication == null && !isPast)
{
    <div class="modal fade" id="applyEventModal" tabindex="-1" aria-labelledby="applyEventModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card border-secondary text-white" style="background: rgba(15, 23, 42, 0.96);">
                <div class="modal-header border-secondary border-opacity-25">
                    <h5 class="modal-title fw-bold text-white" id="applyEventModalLabel">
                        <i class="bi bi-ticket-detailed text-info me-2"></i>Etkinlik Başvurusu
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <form asp-action="Apply" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="eventId" value="@Model.Id" />
                    <div class="modal-body p-4">
                        <div class="mb-3 p-3 rounded-3 bg-dark bg-opacity-60 border border-secondary border-opacity-25">
                            <span class="text-secondary small d-block mb-1">Başvurulan Etkinlik:</span>
                            <h6 class="fw-bold text-white mb-1">@Model.Title</h6>
                            <span class="text-info small font-monospace"><i class="bi bi-calendar3 me-1"></i>@Model.EventDate.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")</span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-light fw-semibold small">Varsa Başvuru Notunuz / Beklentiniz (İsteğe Bağlı)</label>
                            <textarea name="notes" class="form-control bg-dark border-secondary text-white" rows="3" style="border-radius: 12px;" placeholder="Bu etkinliğe katılma motivasyonunuz veya belirtmek istediğiniz detayları yazabilirsiniz..."></textarea>
                        </div>

                        <p class="text-secondary small mb-0" style="line-height: 1.6;">
                            <i class="bi bi-shield-check text-info me-1"></i> Başvurunuz topluluk yöneticileri tarafından değerlendirilecek ve sonucu hesabınızda görüntülenecektir.
                        </p>
                    </div>
                    <div class="modal-footer border-secondary border-opacity-25">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Vazgeç</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow">
                            <i class="bi bi-send-check me-2"></i>Başvuruyu Onayla
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
