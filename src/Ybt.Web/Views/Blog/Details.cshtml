@model Ybt.Core.Entities.Blog
@{
    ViewData["Title"] = Model?.Title ?? "Blog Detayı";
}

<section class="py-5 mt-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <article class="card border-0 overflow-hidden glass-card">
                    @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Title" style="max-height: 420px; object-fit: cover;">
                    }
                    <div class="card-body p-4 p-md-5">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                            <span class="badge bg-info bg-opacity-25 text-info px-3 py-2 border border-info border-opacity-25 rounded-pill">
                                @(string.IsNullOrEmpty(Model?.Category) ? "Yazılım & Teknoloji" : Model.Category)
                            </span>
                            @if (Model != null)
                            {
                                <small class="text-secondary font-monospace">
                                    <i class="bi bi-clock me-1 text-primary"></i> @Model.CreatedAt.ToString("dd MMMM yyyy")
                                </small>
                            }
                        </div>

                        <h1 class="display-6 fw-bold text-white mb-3">@Model?.Title</h1>

                        @if (!string.IsNullOrEmpty(Model?.Summary))
                        {
                            <p class="lead text-info bg-dark bg-opacity-50 p-3 rounded-3 border-start border-info border-3 mb-4">
                                @Model.Summary
                            </p>
                        }

                        @if (Model?.Author != null && !string.IsNullOrEmpty(Model.Author.FullName))
                        {
                            <div class="d-flex align-items-center mb-4">
                                <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span class="text-secondary fw-semibold">@Model.Author.FullName</span>
                            </div>
                        }

                        <hr class="border-secondary border-opacity-25 my-4" />

                        <div class="mb-5 text-light fs-5" style="white-space: pre-line; line-height: 1.8;">
                            @Model?.Content
                        </div>

                        @if (!string.IsNullOrEmpty(Model?.Tags))
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2 pt-3 border-top border-secondary border-opacity-25 mb-4">
                                <span class="text-secondary small me-2"><i class="bi bi-tags me-1"></i>Etiketler:</span>
                                @foreach (var tag in Model.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge bg-dark text-info border border-secondary border-opacity-25 font-monospace px-3 py-2">#@tag.Trim()</span>
                                }
                            </div>
                        }

                        <div class="mt-4">
                            <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                                <i class="bi bi-arrow-left me-2"></i>Bloga Geri Dön
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>
