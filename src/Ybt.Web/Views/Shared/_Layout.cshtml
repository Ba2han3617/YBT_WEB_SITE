<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yazılım ve Bilişim Topluluğu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modern-custom.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }
    <header id="site-header">
        <!-- ── Floating Pill Navigation ───────────────────────── -->
        <div class="fh-bar" id="floatingHeader">
            <div class="fh-inner">

                <!-- Sol: Logo pill -->
                <a class="fh-logo-pill" asp-area="" asp-controller="Home" asp-action="Index" aria-label="YBT Ana Sayfa">
                    <img src="~/assets/images/logo/logo.png" alt="YBT" class="fh-logo-img" />
                </a>

                <!-- Orta: Beyaz pill nav (desktop) -->
                <nav class="fh-pill-nav d-none d-lg-flex" aria-label="Ana navigasyon">
                    <a class="fh-link @(currentController == "Home" ? "fh-link--active" : "")"
                       asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                    <a class="fh-link @(currentController == "About" ? "fh-link--active" : "")"
                       asp-controller="About" asp-action="Index">Hakkımızda</a>
                    <a class="fh-link @(currentController == "Events" ? "fh-link--active" : "")"
                       asp-controller="Events" asp-action="Index">Etkinlikler</a>
                    <a class="fh-link @(currentController == "Projects" ? "fh-link--active" : "")"
                       asp-controller="Projects" asp-action="Index">Projeler</a>
                    <a class="fh-link @(currentController == "Blog" ? "fh-link--active" : "")"
                       asp-controller="Blog" asp-action="Index">Blog</a>
                    <a class="fh-link @(currentController == "Contact" ? "fh-link--active" : "")"
                       asp-controller="Contact" asp-action="Index">İletişim</a>
                </nav>

                <!-- Sağ: Action bölümü -->
                <div class="fh-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <button class="fh-action-btn dropdown-toggle" type="button"
                                    id="fhUserMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i>
                                <span class="d-none d-md-inline">Hesabım</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end fh-dropdown p-2"
                                style="min-width:200px;" aria-labelledby="fhUserMenu">
                                <li>
                                    <div class="px-3 py-2 border-bottom border-white border-opacity-10 mb-1">
                                        <span class="text-white fw-bold d-block" style="font-size:0.85rem;">@User.Identity.Name</span>
                                        <span style="font-size:0.72rem;color:#64748b;">YBT Üyesi</span>
                                    </div>
                                </li>
                                <li>
                                    <a class="dropdown-item fh-dd-item" asp-area="" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person-gear me-2"></i>Profilim
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item fh-dd-item" asp-area="" asp-controller="Account" asp-action="Applications">
                                        <i class="bi bi-calendar-check me-2"></i>Başvurularım
                                    </a>
                                </li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item fh-dd-item fh-dd-item--accent" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                            <i class="bi bi-shield-lock me-2"></i>Yönetim Paneli
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider" style="border-color:rgba(255,255,255,0.08);"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item fh-dd-item fh-dd-item--danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="fh-action-btn">
                            Giriş Yap
                        </a>
                    }

                    <!-- Mobil hamburger -->
                    <button class="fh-burger d-lg-none" type="button"
                            data-bs-toggle="collapse" data-bs-target="#mobileMenu"
                            aria-expanded="false" aria-label="Menü">
                        <span class="fh-burger-line"></span>
                        <span class="fh-burger-line"></span>
                        <span class="fh-burger-line"></span>
                    </button>
                </div>

            </div>

            <!-- Mobil dropdown menü -->
            <div class="collapse fh-mobile-menu" id="mobileMenu">
                <div class="fh-mobile-links">
                    <a class="fh-mobile-link @(currentController == "Home" ? "fh-mobile-link--active" : "")"
                       asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                    <a class="fh-mobile-link @(currentController == "About" ? "fh-mobile-link--active" : "")"
                       asp-controller="About" asp-action="Index">Hakkımızda</a>
                    <a class="fh-mobile-link @(currentController == "Events" ? "fh-mobile-link--active" : "")"
                       asp-controller="Events" asp-action="Index">Etkinlikler</a>
                    <a class="fh-mobile-link @(currentController == "Projects" ? "fh-mobile-link--active" : "")"
                       asp-controller="Projects" asp-action="Index">Projeler</a>
                    <a class="fh-mobile-link @(currentController == "Blog" ? "fh-mobile-link--active" : "")"
                       asp-controller="Blog" asp-action="Index">Blog</a>
                    <a class="fh-mobile-link @(currentController == "Contact" ? "fh-mobile-link--active" : "")"
                       asp-controller="Contact" asp-action="Index">İletişim</a>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <div class="fh-mobile-actions">
                            <a asp-controller="Account" asp-action="Register" class="fh-mobile-cta">
                                Üye Ol
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 mb-4">
                    <img src="~/assets/images/logo/logo.png" alt="YBT Logo" class="footer-logo" />
                    <p class="text-secondary mt-3">Düzce Üniversitesi Yazılım ve Bilişim Topluluğu olarak geleceğin teknolojisini birlikte öğreniyor, üretiyor ve kodluyoruz.</p>
                    <div class="d-flex gap-2 mt-4">
                        <a href="https://www.instagram.com/du.yazilim/" target="_blank" rel="noopener noreferrer" class="social-icon" title="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="https://www.tiktok.com/@@ybt1881" target="_blank" rel="noopener noreferrer" class="social-icon" title="TikTok"><i class="bi bi-tiktok"></i></a>
                        <a href="https://www.linkedin.com/in/d%C3%BCzce-%C3%BCniversitesi-yaz%C4%B1l%C4%B1m-ve-bili%C5%9Fim-toplulu%C4%9Fu-357245383/" target="_blank" rel="noopener noreferrer" class="social-icon" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <a href="https://medium.com/@@yazilimvebilisimtoplulugu" target="_blank" rel="noopener noreferrer" class="social-icon" title="Medium"><i class="bi bi-medium"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-6 mb-4">
                    <h5 class="text-white mb-4 fw-bold">Kurumsal</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a asp-controller="About" asp-action="Index" class="footer-link">Hakkımızda</a></li>
                        <li><a asp-controller="About" asp-action="Index" class="footer-link">Vizyon & Misyon</a></li>
                        <li><a asp-controller="About" asp-action="Index" class="footer-link">Yönetim Kurulu</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-6 mb-4">
                    <h5 class="text-white mb-4 fw-bold">Topluluk</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a asp-controller="Events" asp-action="Index" class="footer-link">Etkinlikler</a></li>
                        <li><a asp-controller="Projects" asp-action="Index" class="footer-link">Projelerimiz</a></li>
                        <li><a asp-controller="Blog" asp-action="Index" class="footer-link">Blog & Yazılar</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h5 class="text-white mb-4 fw-bold">E-Bülten</h5>
                    <p class="text-secondary">Teknoloji zirveleri, atölyeler ve açık kaynak projelerimizden haberdar olun.</p>
                    <form onsubmit="event.preventDefault(); alert('E-bülten kaydınız başarıyla alındı!'); this.reset();" class="input-group mb-3">
                        <input type="email" class="form-control bg-transparent border-secondary text-white px-3" placeholder="E-posta adresiniz" required>
                        <button class="btn btn-primary px-4" type="submit">Abone Ol</button>
                    </form>
                </div>
            </div>
            <hr class="border-secondary border-opacity-25 my-5">
            <div class="text-center text-secondary small">
                <p class="mb-0">&copy; @DateTime.Now.Year Düzce Üniversitesi Yazılım ve Bilişim Topluluğu. Tüm Hakları Saklıdır.</p>
            </div>
        </div>
    </footer>

    @if (TempData["Success"] != null)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div class="toast show align-items-center text-white bg-success border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
                </div>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div class="toast show align-items-center text-white bg-danger border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
                </div>
            </div>
        </div>
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
