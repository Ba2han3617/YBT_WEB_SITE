<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yazılım ve Bilişim Topluluğu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modern-custom.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }
    <header>
        <nav class="navbar navbar-expand-lg fixed-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/assets/images/logo/logo.png" alt="YBT Logo" class="img-fluid" style="height: 42px; filter: drop-shadow(0 0 8px rgba(56,189,248,0.5));" />
                    <span class="fw-extrabold fs-5 font-outfit text-white">Yazılım & Bilişim</span>
                </a>
                <button class="navbar-toggler border-secondary" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Menüyü Aç/Kapat">
                    <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "About" ? "active" : "")" asp-controller="About" asp-action="Index">Hakkımızda</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Events" ? "active" : "")" asp-controller="Events" asp-action="Index">Etkinlikler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Projects" ? "active" : "")" asp-controller="Projects" asp-action="Index">Projeler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Blog" ? "active" : "")" asp-controller="Blog" asp-action="Index">Blog</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Contact" ? "active" : "")" asp-controller="Contact" asp-action="Index">İletişim</a>
                        </li>
                    </ul>
                    <div class="ms-lg-3 mt-3 mt-lg-0 d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-primary rounded-pill px-4 dropdown-toggle d-flex align-items-center gap-2 shadow" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5"></i>
                                    <span>Hesabım</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg glass-card p-2" style="min-width: 200px;" aria-labelledby="userMenu">
                                    <li>
                                        <div class="px-3 py-2 text-secondary small border-bottom border-secondary border-opacity-25 mb-1">
                                            <span class="text-white fw-bold d-block">@User.Identity.Name</span>
                                            <span class="text-muted" style="font-size: 0.75rem;">YBT Üyesi</span>
                                        </div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2 text-white" asp-area="" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-gear me-2 text-info"></i>Profilim
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2 text-white" asp-area="" asp-controller="Account" asp-action="Applications">
                                            <i class="bi bi-calendar-check me-2 text-info"></i>Başvurularım
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item rounded-3 py-2 text-info" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                                <i class="bi bi-shield-lock me-2"></i>Yönetim Paneli
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider border-secondary border-opacity-50"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            <button type="submit" class="dropdown-item rounded-3 py-2 text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary rounded-pill px-4">Giriş Yap</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary rounded-pill px-4 shadow">Katıl</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 mb-4">
                    <img src="~/assets/images/logo/logo.png" alt="YBT Logo" class="footer-logo" />
                    <p class="text-secondary mt-3">Düzce Üniversitesi Yazılım ve Bilişim Topluluğu olarak geleceğin teknolojisini birlikte öğreniyor, üretiyor ve kodluyoruz.</p>
                    <div class="d-flex gap-2 mt-4">
                        <a href="https://www.instagram.com/du.yazilim/" target="_blank" rel="noopener noreferrer" class="social-icon" title="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="https://www.tiktok.com/@@ybt1881" target="_blank" rel="noopener noreferrer" class="social-icon" title="TikTok"><i class="bi bi-tiktok"></i></a>
                        <a href="https://www.linkedin.com/in/d%C3%BCzce-%C3%BCniversitesi-yaz%C4%B1l%C4%B1m-ve-bili%C5%9Fim-toplulu%C4%9Fu-357245383/" target="_blank" rel="noopener noreferrer" class="social-icon" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <a href="https://medium.com/@@yazilimvebilisimtoplulugu" target="_blank" rel="noopener noreferrer" class="social-icon" title="Medium"><i class="bi bi-medium"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-6 mb-4">
                    <h5 class="text-white mb-4 fw-bold">Kurumsal</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a asp-controller="About" asp-action="Index" class="footer-link">Hakkımızda</a></li>
                        <li><a asp-controller="About" asp-action="Index" class="footer-link">Vizyon & Misyon</a></li>
                        <li><a asp-controller="About" asp-action="Index" class="footer-link">Yönetim Kurulu</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-6 mb-4">
                    <h5 class="text-white mb-4 fw-bold">Topluluk</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a asp-controller="Events" asp-action="Index" class="footer-link">Etkinlikler</a></li>
                        <li><a asp-controller="Projects" asp-action="Index" class="footer-link">Projelerimiz</a></li>
                        <li><a asp-controller="Blog" asp-action="Index" class="footer-link">Blog & Yazılar</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h5 class="text-white mb-4 fw-bold">E-Bülten</h5>
                    <p class="text-secondary">Teknoloji zirveleri, atölyeler ve açık kaynak projelerimizden haberdar olun.</p>
                    <form onsubmit="event.preventDefault(); alert('E-bülten kaydınız başarıyla alındı!'); this.reset();" class="input-group mb-3">
                        <input type="email" class="form-control bg-transparent border-secondary text-white px-3" placeholder="E-posta adresiniz" required>
                        <button class="btn btn-primary px-4" type="submit">Abone Ol</button>
                    </form>
                </div>
            </div>
            <hr class="border-secondary border-opacity-25 my-5">
            <div class="text-center text-secondary small">
                <p class="mb-0">&copy; @DateTime.Now.Year Düzce Üniversitesi Yazılım ve Bilişim Topluluğu. Tüm Hakları Saklıdır.</p>
            </div>
        </div>
    </footer>

    @if (TempData["Success"] != null)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div class="toast show align-items-center text-white bg-success border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
                </div>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div class="toast show align-items-center text-white bg-danger border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
                </div>
            </div>
        </div>
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
