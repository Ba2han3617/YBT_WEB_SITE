<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yazılım ve Bilişim Topluluğu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modern-custom.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg fixed-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/assets/images/logo/logo.png" alt="YBT Logo" class="img-fluid" />
                    <span class="fw-bold fs-5 text-navy">Yazılım ve Bilişim</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="About" asp-action="Index">Hakkımızda</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Index">Etkinlikler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Projects" asp-action="Index">Projeler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Blog" asp-action="Index">Blog</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contact" asp-action="Index">İletişim</a>
                        </li>
                    </ul>
                    <div class="ms-lg-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-primary dropdown-toggle" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-2"></i>@User.Identity.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow" aria-labelledby="userMenu">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Profilim</a></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin Panel</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item text-danger">Çıkış Yap</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="mt-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4">
                    <img src="~/assets/images/logo/logo.png" alt="YBT Logo" class="footer-logo" />
                    <p class="text-secondary mt-3">Yazılım ve Bilişim Topluluğu olarak geleceği birlikte kodluyoruz.</p>
                    <div class="d-flex gap-2 mt-4">
                        <a href="https://www.instagram.com/du.yazilim/" target="_blank" rel="noopener noreferrer" class="social-icon"><i class="bi bi-instagram"></i></a>
                        <a href="https://www.tiktok.com/@@ybt1881" target="_blank" rel="noopener noreferrer" class="social-icon"><i class="bi bi-tiktok"></i></a>
                        <a href="https://www.linkedin.com/in/d%C3%BCzce-%C3%BCniversitesi-yaz%C4%B1l%C4%B1m-ve-bili%C5%9Fim-toplulu%C4%9Fu-357245383/" target="_blank" rel="noopener noreferrer" class="social-icon"><i class="bi bi-linkedin"></i></a>
                        <a href="https://medium.com/@@yazilimvebilisimtoplulugu" target="_blank" rel="noopener noreferrer" class="social-icon"><i class="bi bi-medium"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 mb-4">
                    <h5 class="text-white mb-4">Kurumsal</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="footer-link">Hakkımızda</a></li>
                        <li><a href="#" class="footer-link">Vizyon & Misyon</a></li>
                        <li><a href="#" class="footer-link">Yönetim Ekibi</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 mb-4">
                    <h5 class="text-white mb-4">Topluluk</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="footer-link">Etkinlikler</a></li>
                        <li><a href="#" class="footer-link">Projeler</a></li>
                        <li><a href="#" class="footer-link">Blog</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h5 class="text-white mb-4">Bülten</h5>
                    <p class="text-secondary">Gelişmelerden haberdar olmak için abone olun.</p>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control bg-transparent border-secondary text-white" placeholder="E-posta adresiniz">
                        <button class="btn btn-primary" type="button">Abone Ol</button>
                    </div>
                </div>
            </div>
            <hr class="border-secondary my-5">
            <div class="text-center text-secondary">
                <p>&copy; @DateTime.Now.Year Yazılım ve Bilişim Topluluğu. Tüm Hakları Saklıdır.</p>
            </div>
        </div>
    </footer>

    @if (TempData["Success"] != null)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div class="toast show align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">@TempData["Success"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div class="toast show align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">@TempData["Error"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
