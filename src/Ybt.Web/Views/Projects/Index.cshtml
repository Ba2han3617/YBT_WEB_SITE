@model IEnumerable<Ybt.Core.Entities.Project>
@{
    ViewData["Title"] = "Projelerimiz";
}

<section class="py-5 mt-5">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <span class="section-tag">Açık Kaynak & İnovasyon</span>
            <h1 class="display-4 fw-extrabold gradient-text">Projelerimiz</h1>
            <p class="lead text-secondary fs-5">Öğrencilerimizle geliştirdiğimiz ve açık kaynak dünyasına kazandırdığımız projeler.</p>
        </div>
        <div class="row g-4">
            @if (!Model.Any())
            {
                <div class="col-12 text-center py-5">
                    <p class="text-secondary fs-5">Henüz yayınlanmış bir proje bulunmamaktadır.</p>
                </div>
            }
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 reveal">
                    <div class="card h-100 border-0">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center mb-3">
                                    <div class="feature-icon-box mb-0 me-3" style="width: 48px; height: 48px; font-size: 1.3rem;">
                                        <i class="bi bi-code-slash"></i>
                                    </div>
                                    <h4 class="fw-bold text-white mb-0">@item.Name</h4>
                                </div>
                                <p class="text-secondary mb-4 small">@item.Description</p>
                                @if (!string.IsNullOrEmpty(item.TechTags))
                                {
                                    <div class="mb-4">
                                        @foreach (var tag in item.TechTags.Split(','))
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 me-1 mb-1 font-monospace">@tag.Trim()</span>
                                        }
                                    </div>
                                }
                            </div>
                            <a href="@item.GitHubUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary w-100 rounded-pill"><i class="bi bi-github me-2"></i>GitHub'da İncele</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
