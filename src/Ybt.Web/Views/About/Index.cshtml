@model Ybt.Web.Models.AboutViewModel
@{
    ViewData["Title"] = "Hakkımızda";
    ViewData["Description"] = "Düzce Üniversitesi Yazılım ve Bilişim Topluluğu (YBT) hakkında bilgi, misyon, vizyon, faaliyet alanlarımız ve yönetim ekibimiz.";
}

<!-- ═══════════════════════════════════════════════
     HERO & BİZ KİMİZ?
     ═══════════════════════════════════════════════ -->
<section class="about-hero-section" aria-label="Hakkımızda Giriş">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="container position-relative z-2">
        <div class="row align-items-center g-5">
            <div class="col-lg-7 reveal">
                <div class="hero-top-badge mb-3">
                    <span class="htb-dot"></span>
                    <span>Düzce Üniversitesi &nbsp;·&nbsp; YBT Ekosistemi</span>
                </div>
                <h1 class="hero-h1 mb-3">
                    Yazılım, İnovasyon ve<br>
                    <span class="hero-h1-accent">Birlikte Üretim</span> Ekosistemi
                </h1>
                <p class="hero-sub mb-3">
                    Geleceğin teknoloji liderlerini ve yazılımcılarını bir araya getiren bağımsız topluluk.
                </p>
                <p class="hero-desc mb-4">
                    Düzce Üniversitesi Yazılım ve Bilişim Topluluğu (YBT); öğrencilerin teorik bilgilerini gerçek dünya projelerine dönüştürdüğü, açık kaynak kültürünün benimsendiği ve teknik yetkinliklerin geliştirildiği dinamik bir üniversite teknoloji platformudur.
                </p>

                <!-- Metrik Rozetleri -->
                <div class="about-stats-strip">
                    <div class="astat-item">
                        <span class="astat-val">500+</span>
                        <span class="astat-lbl">Aktif Üye</span>
                    </div>
                    <div class="astat-sep"></div>
                    <div class="astat-item">
                        <span class="astat-val">100+</span>
                        <span class="astat-lbl">Etkinlik &amp; Atölye</span>
                    </div>
                    <div class="astat-sep"></div>
                    <div class="astat-item">
                        <span class="astat-val">20+</span>
                        <span class="astat-lbl">Açık Kaynak Proje</span>
                    </div>
                    <div class="astat-sep"></div>
                    <div class="astat-item">
                        <span class="astat-val">10+</span>
                        <span class="astat-lbl">Hackathon Derecesi</span>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-5 reveal d-none d-lg-block">
                <div class="about-hero-card">
                    <div class="ahc-header">
                        <span class="ahc-dot red"></span>
                        <span class="ahc-dot yellow"></span>
                        <span class="ahc-dot green"></span>
                        <span class="ahc-title">about-ybt.json</span>
                    </div>
                    <div class="ahc-body font-monospace">
                        <div class="ahc-line"><span class="ahc-k">"name"</span>: <span class="ahc-v">"Yazılım ve Bilişim Topluluğu"</span>,</div>
                        <div class="ahc-line"><span class="ahc-k">"shortName"</span>: <span class="ahc-v">"YBT"</span>,</div>
                        <div class="ahc-line"><span class="ahc-k">"university"</span>: <span class="ahc-v">"Düzce Üniversitesi"</span>,</div>
                        <div class="ahc-line"><span class="ahc-k">"focusAreas"</span>: [</div>
                        <div class="ahc-line indent"><span class="ahc-v">"Web &amp; Mobile Dev"</span>,</div>
                        <div class="ahc-line indent"><span class="ahc-v">"AI &amp; Data Science"</span>,</div>
                        <div class="ahc-line indent"><span class="ahc-v">"Open Source Culture"</span>,</div>
                        <div class="ahc-line indent"><span class="ahc-v">"Hackathons &amp; Competitions"</span></div>
                        <div class="ahc-line">],</div>
                        <div class="ahc-line"><span class="ahc-k">"status"</span>: <span class="ahc-s">"ACTIVE_PRODUCING"</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════
     MİSYON & VİZYON
     ═══════════════════════════════════════════════ -->
<section class="section-block section-alt" aria-label="Misyon ve Vizyon">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6 reveal">
                <div class="mv-card h-100">
                    <div class="mv-icon-wrap icon-cyan">
                        <i class="bi bi-compass"></i>
                    </div>
                    <h2 class="mv-title">Misyonumuz</h2>
                    <p class="mv-desc">
                        Üyelerimize pratik proje geliştirme deneyimi, açık kaynak kültürü ve takım çalışması disiplini kazandırarak; akademiden sektöre geçişte ulusal ve uluslararası standartlarda donanımlı yazılımcılar ve mühendisler yetiştirmek.
                    </p>
                </div>
            </div>
            <div class="col-md-6 reveal">
                <div class="mv-card h-100">
                    <div class="mv-icon-wrap icon-purple">
                        <i class="bi bi-eye"></i>
                    </div>
                    <h2 class="mv-title">Vizyonumuz</h2>
                    <p class="mv-desc">
                        Türkiye’nin en üretken, inovatif ve ilham veren üniversite teknoloji topluluklarından biri olarak; açık kaynak ekosisteminde, hackathon maratonlarında ve yazılım dünyasında kalıcı, sürdürülebilir izler bırakmak.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════
     FAALİYET ALANLARIMIZ (DB Sourced Cards)
     ═══════════════════════════════════════════════ -->
<section class="section-block" aria-label="Faaliyet Alanlarımız">
    <div class="container">
        <div class="section-header text-center reveal">
            <span class="section-tag">Ne Yapıyoruz?</span>
            <h2 class="section-title gradient-text">Faaliyet Alanlarımız</h2>
            <p class="section-desc">YBT çatısı altında yürüttüğümüz temel çalışma ve üretim alanları.</p>
        </div>

        @if (Model.AboutFeatures != null && Model.AboutFeatures.Any())
        {
            <div class="row g-4 mt-2">
                @foreach (var feature in Model.AboutFeatures)
                {
                    var iconClass = string.IsNullOrWhiteSpace(feature.Icon) ? "bi-code-slash" : feature.Icon;
                    var accentClass = feature.AccentType?.ToLower() switch
                    {
                        "purple" => "icon-purple",
                        "teal" => "icon-teal",
                        _ => "icon-cyan"
                    };

                    <div class="col-lg-4 col-md-6 reveal">
                        <div class="feature-card h-100">
                            <div class="feature-icon-wrap @accentClass">
                                <i class="bi @iconClass"></i>
                            </div>
                            <h3 class="feature-title">@feature.Title</h3>
                            <p class="feature-desc">@feature.Description</p>
                            @if (!string.IsNullOrEmpty(feature.Tags))
                            {
                                <div class="feature-tags">
                                    @foreach (var tag in feature.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="ftag">@tag.Trim()</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state reveal">
                <div class="empty-icon"><i class="bi bi-info-square"></i></div>
                <p class="empty-text">Henüz yönetilebilir içerik eklenmemiş. Yakında eklenecek!</p>
            </div>
        }
    </div>
</section>

<!-- ═══════════════════════════════════════════════
     TOPLULUK DEĞERLERİMİZ / NASIL ÇALIŞIYORUZ?
     ═══════════════════════════════════════════════ -->
<section class="section-block section-alt" aria-label="Topluluk Değerleri">
    <div class="container">
        <div class="section-header text-center reveal">
            <span class="section-tag">Kültürümüz</span>
            <h2 class="section-title gradient-text">Topluluk Değerlerimiz</h2>
            <p class="section-desc">Bizi bir arada tutan ve üretimimizi şekillendiren temel ilkelerimiz.</p>
        </div>

        <div class="row g-4 mt-2">
            <div class="col-lg-3 col-md-6 reveal">
                <div class="value-card">
                    <span class="value-num">01</span>
                    <h4 class="value-title">Birlikte Üretim</h4>
                    <p class="value-desc">Tek başımıza değil, bir araya gelerek büyük projeler ve sistemler inşa ederiz.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 reveal">
                <div class="value-card">
                    <span class="value-num">02</span>
                    <h4 class="value-title">Açık Kaynak</h4>
                    <p class="value-desc">Ürettiğimiz kodu ve bilgiyi toplulukla paylaşarak kolektif gelişimi destekleriz.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 reveal">
                <div class="value-card">
                    <span class="value-num">03</span>
                    <h4 class="value-title">Sürekli Öğrenme</h4>
                    <p class="value-desc">Teknolojideki hızlı değişime ayak uydurur, yeni araç ve yaklaşımları deneriz.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 reveal">
                <div class="value-card">
                    <span class="value-num">04</span>
                    <h4 class="value-title">Sektör Odaklılık</h4>
                    <p class="value-desc">Öğrendiklerimizi gerçek dünya problemleri ve sektör ihtiyaçlarıyla hizalarız.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════
     YÖNETİM EKİBİ
     ═══════════════════════════════════════════════ -->
@if (Model.TeamMembers != null && Model.TeamMembers.Any())
{
    <section class="section-block" aria-label="Yönetim Kurulu">
        <div class="container">
            <div class="section-header text-center reveal">
                <span class="section-tag">Liderlik</span>
                <h2 class="section-title gradient-text">Yönetim Kurulumuz</h2>
                <p class="section-desc">YBT'nin vizyonunu ileriye taşıyan ve operasyonları yöneten ekibimiz.</p>
            </div>
            <div class="row g-4 mt-2 justify-content-center">
                @foreach (var member in Model.TeamMembers)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6 reveal">
                        <div class="team-card-v2 h-100" id="member-@member.Id">
                            <div class="team-avatar-v2">
                                @if (!string.IsNullOrEmpty(member.ImageUrl))
                                {
                                    <img src="@member.ImageUrl" alt="@member.FullName" loading="lazy" />
                                }
                                else
                                {
                                    <div class="team-avatar-placeholder">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                }
                            </div>
                            <div class="team-info-v2">
                                <h4 class="team-name-v2">@member.FullName</h4>
                                <p class="team-role-v2 font-monospace">@member.Role</p>
                                @if (!string.IsNullOrEmpty(member.Bio))
                                {
                                    <p class="team-bio-v2 mb-3">@member.Bio</p>
                                }
                                <div class="team-socials-v2 mt-auto">
                                    @if (!string.IsNullOrEmpty(member.LinkedInUrl))
                                    {
                                        <a href="@member.LinkedInUrl" target="_blank" rel="noopener noreferrer" title="LinkedIn" class="team-social-link">
                                            <i class="bi bi-linkedin"></i>
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(member.GitHubUrl))
                                    {
                                        <a href="@member.GitHubUrl" target="_blank" rel="noopener noreferrer" title="GitHub" class="team-social-link">
                                            <i class="bi bi-github"></i>
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(member.Email))
                                    {
                                        <a href="mailto:@member.Email" title="E-posta" class="team-social-link">
                                            <i class="bi bi-envelope"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- ═══════════════════════════════════════════════
     CTA BANNER
     ═══════════════════════════════════════════════ -->
<section class="cta-section" aria-label="Topluluğa katılım çağrısı">
    <div class="cta-bg-glow" aria-hidden="true"></div>
    <div class="container position-relative">
        <div class="cta-inner text-center reveal">
            <div class="cta-badge mb-3">
                <i class="bi bi-rocket-takeoff-fill me-1"></i> Bize Katılın
            </div>
            <h2 class="cta-title">Geleceğin Teknolojisini<br class="d-none d-md-block"> Birlikte Kodlayalım</h2>
            <p class="cta-desc">Projeler geliştirmek, etkinliklere katılmak ve sektörle buluşmak için hemen YBT üyesi ol.</p>
            <div class="d-flex flex-wrap gap-3 justify-content-center mt-4">
                <a asp-controller="Account" asp-action="Register" class="btn btn-cta-primary">
                    <i class="bi bi-person-plus-fill me-2"></i>Topluluğa Katıl
                </a>
                <a asp-controller="Contact" asp-action="Index" class="btn btn-cta-outline">
                    <i class="bi bi-envelope me-2"></i>İletişime Geç
                </a>
            </div>
        </div>
    </div>
</section>
