@{
    ViewData["Title"] = "Erişim Reddedildi - Yetkisiz İşlem";
}

<div class="container py-5 my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="glass-card p-5 rounded-4 shadow-lg border border-danger border-opacity-25 position-relative overflow-hidden">
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 p-4 mb-3" style="width: 100px; height: 100px;">
                        <i class="bi bi-shield-lock-fill display-4"></i>
                    </div>
                    <h2 class="fw-bold text-white mb-2">Erişim Engellendi (403)</h2>
                    <p class="text-secondary mb-0">Bu sayfayı veya yönetim panelini görüntülemek için gerekli yönetici (Admin) yetkilerine sahip değilsiniz.</p>
                </div>

                <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25 text-start small mb-4">
                    <div class="text-light mb-1"><i class="bi bi-info-circle text-info me-2"></i><strong>Ne yapabilirsiniz?</strong></div>
                    <ul class="text-secondary mb-0 ps-3">
                        <li>Eğer yöneticiyseniz, <a href="/ybt-yonetim" class="text-info text-decoration-none">Yönetici Girişi</a> sayfasından yetkili hesabınızla oturum açınız.</li>
                        <li>Normal bir topluluk üyesiyseniz, etkinliklere katılabilir ve projelerinizi inceleyebilirsiniz.</li>
                    </ul>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                    <a href="/" class="btn btn-primary rounded-pill px-4 shadow">
                        <i class="bi bi-house-door me-2"></i>Ana Sayfaya Dön
                    </a>
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-person me-2"></i>Profilime Git
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
