@model LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5 reveal">
            <div class="card p-4 p-md-5 border-0 shadow-lg glass-card">
                <div class="text-center mb-4">
                    <img src="~/assets/images/logo/logo.png" alt="YBT Logo" class="login-logo img-fluid mb-3" style="max-height: 80px; max-width: 120px; width: auto;" />
                    <h2 class="fw-bold">Hoş Geldiniz</h2>
                    <p class="text-secondary">YBT hesabınıza giriş yapın.</p>
                </div>
                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger small mb-3 rounded-3"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control rounded-pill px-4" placeholder="E-posta veya Kullanıcı Adı" autofocus>
                        <label asp-for="Email" class="ms-3">E-posta Adresi *</label>
                        <span asp-validation-for="Email" class="text-danger small ms-3"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control rounded-pill px-4" placeholder="Şifreniz">
                        <label asp-for="Password" class="ms-3">Şifre *</label>
                        <span asp-validation-for="Password" class="text-danger small ms-3"></span>
                    </div>
                    <div class="form-check mb-4 ms-2">
                        <input asp-for="RememberMe" class="form-check-input" id="rememberMe">
                        <label asp-for="RememberMe" class="form-check-label text-secondary small" for="rememberMe">Beni Hatırla</label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-lg">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Giriş Yap
                    </button>
                </form>
                <div class="text-center mt-4">
                    <p class="text-secondary mb-0">Hesabınız yok mu? <a asp-action="Register" class="text-primary text-decoration-none fw-bold">Şimdi Katılın</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
