@model Ybt.Core.Entities.AppUser
@{
    ViewData["Title"] = "Profilim";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 reveal">
            <div class="card p-4 p-md-5 border-0 shadow-lg glass-card">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle mb-3" style="width: 80px; height: 80px; font-size: 2.5rem;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <h2 class="fw-bold">@Model.FullName</h2>
                    <p class="text-secondary">Kullanıcı Profil Bilgileri</p>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                            <label class="text-secondary small d-block mb-1"><i class="bi bi-person me-2 text-info"></i>Ad</label>
                            <span class="fw-semibold text-white fs-6">@(string.IsNullOrEmpty(Model.FirstName) ? "-" : Model.FirstName)</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                            <label class="text-secondary small d-block mb-1"><i class="bi bi-person me-2 text-info"></i>Soyad</label>
                            <span class="fw-semibold text-white fs-6">@(string.IsNullOrEmpty(Model.LastName) ? "-" : Model.LastName)</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                            <label class="text-secondary small d-block mb-1"><i class="bi bi-envelope me-2 text-info"></i>E-posta Adresi</label>
                            <span class="fw-semibold text-white fs-6">@(string.IsNullOrEmpty(Model.Email) ? "-" : Model.Email)</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                            <label class="text-secondary small d-block mb-1"><i class="bi bi-telephone me-2 text-info"></i>Cep Numarası</label>
                            <span class="fw-semibold text-white fs-6">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                            <label class="text-secondary small d-block mb-1"><i class="bi bi-building me-2 text-info"></i>Fakülte / MYO</label>
                            <span class="fw-semibold text-white fs-6">@(string.IsNullOrEmpty(Model.Faculty) ? "-" : Model.Faculty)</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                            <label class="text-secondary small d-block mb-1"><i class="bi bi-card-heading me-2 text-info"></i>Öğrenci Numarası</label>
                            <span class="fw-semibold text-white fs-6">@(string.IsNullOrEmpty(Model.StudentNumber) ? "-" : Model.StudentNumber)</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                            <label class="text-secondary small d-block mb-1"><i class="bi bi-geo-alt me-2 text-info"></i>Adres</label>
                            <span class="fw-semibold text-white fs-6">@(string.IsNullOrEmpty(Model.Address) ? "-" : Model.Address)</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3 mt-4 pt-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                        <i class="bi bi-house me-2"></i>Ana Sayfa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
