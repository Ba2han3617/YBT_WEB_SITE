@model LoginViewModel
@{
    ViewData["Title"] = "Admin Girişi";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YBT Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modern-custom.css" asp-append-version="true" />
    <style>
        body {
            background-color: #070b14;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
            color: #f8fafc;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(139, 92, 246, 0.2) 0%, transparent 45%),
                radial-gradient(circle at 85% 65%, rgba(56, 189, 248, 0.18) 0%, transparent 45%),
                radial-gradient(2px 2px at 20px 30px, #ffffff, rgba(0,0,0,0)),
                radial-gradient(2px 2px at 50px 90px, rgba(255,255,255,0.7), rgba(0,0,0,0)),
                radial-gradient(1px 1px at 130px 40px, #ffffff, rgba(0,0,0,0)),
                radial-gradient(2px 2px at 180px 140px, rgba(255,255,255,0.9), rgba(0,0,0,0));
            background-size: 100% 100%, 100% 100%, 250px 250px, 300px 300px, 200px 200px, 350px 350px;
        }
        .admin-login-container {
            width: 100%;
            max-width: 440px;
            padding: 20px;
        }
        .admin-login-card {
            background: rgba(15, 23, 42, 0.8) !important;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(56, 189, 248, 0.2) !important;
            border-radius: 20px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 30px rgba(56, 189, 248, 0.1);
            padding: 40px;
        }
        .admin-header {
            text-align: center;
            margin-bottom: 30px;
        }
        .admin-logo {
            height: 70px;
            width: auto;
            margin-bottom: 16px;
            display: block;
            margin-left: auto;
            margin-right: auto;
            filter: drop-shadow(0 0 10px rgba(56,189,248,0.4));
        }
        .admin-badge {
            display: inline-block;
            background: rgba(56, 189, 248, 0.1);
            border: 1px solid rgba(56, 189, 248, 0.3);
            color: #38bdf8;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 16px;
            letter-spacing: 1px;
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.15);
        }
        .admin-header h2 {
            color: #ffffff;
            font-weight: 800;
            font-size: 26px;
            margin-bottom: 6px;
            letter-spacing: -0.02em;
        }
        .admin-header p {
            color: #94a3b8;
            font-size: 14px;
            margin: 0;
        }
        .form-label-space {
            color: #cbd5e1;
            font-weight: 500;
            font-size: 13px;
            margin-bottom: 6px;
        }
        .form-control-space {
            background-color: rgba(15, 23, 42, 0.7) !important;
            border: 1px solid rgba(56, 189, 248, 0.25) !important;
            border-radius: 10px !important;
            padding: 12px 16px !important;
            font-size: 14px !important;
            color: #f8fafc !important;
            transition: all 0.3s ease !important;
        }
        .form-control-space::placeholder {
            color: #64748b !important;
        }
        .form-control-space:focus {
            background-color: rgba(15, 23, 42, 0.9) !important;
            border-color: #38bdf8 !important;
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.3) !important;
            color: #ffffff !important;
        }
        .btn-admin-login {
            background: linear-gradient(135deg, #38bdf8 0%, #8b5cf6 100%);
            border: none;
            border-radius: 10px;
            padding: 12px 0;
            font-weight: 700;
            font-size: 15px;
            color: white;
            margin-top: 15px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(56, 189, 248, 0.3);
        }
        .btn-admin-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(56, 189, 248, 0.45);
            color: white;
        }
        .form-check-input-space {
            width: 18px;
            height: 18px;
            cursor: pointer;
            background-color: rgba(15, 23, 42, 0.8);
            border: 1px solid rgba(56, 189, 248, 0.3);
        }
        .form-check-input-space:checked {
            background-color: #38bdf8;
            border-color: #38bdf8;
        }
        .form-check-label-space {
            color: #cbd5e1;
            font-size: 13px;
            cursor: pointer;
        }
        .alert-space {
            background-color: rgba(225, 29, 72, 0.15) !important;
            border: 1px solid rgba(244, 63, 94, 0.4) !important;
            color: #fecdd3 !important;
            border-radius: 10px !important;
            font-size: 14px !important;
        }
        .alert-space .btn-close {
            filter: invert(1);
        }
        .border-top-space {
            border-top: 1px solid rgba(56, 189, 248, 0.15) !important;
        }
        .footer-text {
            color: #64748b;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <div class="admin-login-container">
        <div class="admin-login-card">
            <div class="admin-header">
                <img src="~/assets/images/logo/logo.png" alt="YBT Logo" class="admin-logo" />
                <div class="admin-badge">YÖNETİM ALANINA GİRİŞ</div>
                <h2>Admin Paneli</h2>
                <p>Lütfen kimlik bilgilerinizi girin</p>
            </div>

            <form asp-action="AdminLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-space alert-dismissible fade show" role="alert">
                        <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Email" class="form-label form-label-space">Kullanıcı Adı veya Email</label>
                    <input asp-for="Email" class="form-control form-control-space" placeholder="admin" autofocus>
                    <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label form-label-space">Şifre</label>
                    <input asp-for="Password" class="form-control form-control-space" placeholder="Şifrenizi girin">
                    <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input form-check-input-space" asp-for="RememberMe" id="rememberMe">
                    <label class="form-check-label form-check-label-space" for="rememberMe">
                        Beni Hatırla
                    </label>
                </div>

                <button type="submit" class="btn btn-admin-login w-100">
                    <i class="bi bi-lock-fill me-1"></i> Giriş Yap
                </button>
            </form>

            <div class="mt-4 pt-3 border-top-space">
                <p class="text-center footer-text mb-0">
                    &copy; @DateTime.Now.Year - Yazılım ve Bilişim Topluluğu
                </p>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
