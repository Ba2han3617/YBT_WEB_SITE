@section Scripts {
<script>
// Counter animasyonu metrics şeridinde de çalışsın
(function() {
    const heroMetrics = document.querySelector('.hero-metrics');
    if (!heroMetrics) return;
    const obs = new IntersectionObserver((entries, o) => {
        entries.forEach(e => {
            if (e.isIntersecting) {
                e.target.querySelectorAll('.counter-value').forEach(c => {
                    const target = parseInt(c.getAttribute('data-target') || '0', 10);
                    const suffix = c.getAttribute('data-suffix') || '';
                    const dur = 1600;
                    const start = performance.now();
                    function tick(now) {
                        const p = Math.min((now - start) / dur, 1);
                        const ease = 1 - Math.pow(1 - p, 3);
                        c.textContent = Math.round(ease * target) + suffix;
                        if (p < 1) requestAnimationFrame(tick);
                        else c.textContent = target + suffix;
                    }
                    requestAnimationFrame(tick);
                });
                o.unobserve(e.target);
            }
        });
    }, { threshold: 0.4 });
    obs.observe(heroMetrics);
})();
</script>
}
