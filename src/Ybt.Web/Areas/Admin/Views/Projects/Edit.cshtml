@model Ybt.Core.Entities.Project
@{
    ViewData["Title"] = "Projeyi Düzenle";
    Layout = "_AdminLayout";
}

<div class="card p-4">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" />
        <input type="hidden" asp-for="CreatedAt" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-8">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Proje Adı</label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="5" required></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label asp-for="TechTags" class="form-label">Teknoloji Etiketleri</label>
                    <input asp-for="TechTags" class="form-control" />
                    <small class="text-secondary">Virgülle ayırarak yazınız.</small>
                    <span asp-validation-for="TechTags" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GitHubUrl" class="form-label">GitHub Bağlantısı</label>
                    <input asp-for="GitHubUrl" class="form-control" />
                    <span asp-validation-for="GitHubUrl" class="text-danger"></span>
                </div>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mb-3">
                        <label class="form-label d-block">Mevcut Görsel</label>
                        <img src="@Model.ImageUrl" class="img-thumbnail rounded-3" style="max-height: 120px;" />
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">Görseli Değiştir</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*" />
                </div>

                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">Aktif mi?</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary px-5">Güncelle</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
