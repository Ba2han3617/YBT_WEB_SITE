@model IEnumerable<Ybt.Core.Entities.Project>
@{
    ViewData["Title"] = "Proje Yönetimi";
    Layout = "_AdminLayout";
}

<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0 fw-bold text-white">Proje Listesi</h5>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i> Yeni Proje Ekle</a>
    </div>
    <div class="table-responsive">
        <table id="projectsTable" class="table table-hover">
            <thead>
                <tr>
                    <th>Proje Adı</th>
                    <th>Teknolojiler</th>
                    <th>GitHub Bağlantısı</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold text-white">@item.Name</td>
                        <td><small class="text-info font-monospace">@item.TechTags</small></td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.GitHubUrl))
                            {
                                <a href="@item.GitHubUrl" target="_blank" class="text-secondary text-decoration-none small">
                                    <i class="bi bi-github me-1"></i>Kaynak Kod
                                </a>
                            }
                            else
                            {
                                <span class="text-secondary small">-</span>
                            }
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25">Pasif</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu projeyi silmek istediğinize emin misiniz?')" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-danger rounded-0 rounded-end" title="Sil"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#projectsTable').DataTable({
                "pageLength": 10,
                "responsive": true
            });
        });
    </script>
}
