@model Ybt.Core.Entities.Project
@{
    ViewData["Title"] = "Yeni Proje Ekle";
    Layout = "_AdminLayout";
}

<div class="card p-4">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-8">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Proje Adı</label>
                    <input asp-for="Name" class="form-control" placeholder="Örn: YBT Web Portalı" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="5" placeholder="Projenin amacı ve kapsamı..." required></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label asp-for="TechTags" class="form-label">Teknoloji Etiketleri</label>
                    <input asp-for="TechTags" class="form-control" placeholder="Örn: .NET 9, PostgreSQL, Docker" />
                    <small class="text-secondary">Virgülle ayırarak yazınız.</small>
                    <span asp-validation-for="TechTags" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GitHubUrl" class="form-label">GitHub Bağlantısı</label>
                    <input asp-for="GitHubUrl" class="form-control" placeholder="https://github.com/..." />
                    <span asp-validation-for="GitHubUrl" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Proje Görseli</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*" />
                </div>

                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                        <label asp-for="IsActive" class="form-check-label">Aktif mi?</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary px-5">Kaydet</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
