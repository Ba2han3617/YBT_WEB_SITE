<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YBT Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modern-custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        body { background-color: #0f172a; color: #f8fafc; }
        .sidebar { background: #1e293b; min-height: 100vh; border-right: 1px solid #334155; }
        .nav-link { color: #94a3b8; }
        .nav-link:hover, .nav-link.active { color: #fff; background: #334155; border-radius: 8px; }
        .card { background: #1e293b; border: 1px solid #334155; color: #fff; }
        .text-dark { color: #f8fafc !important; }
        .table { color: #f8fafc; }
        .form-control, .form-select { background-color: #0f172a; border-color: #334155; color: #fff; }
        .form-control:focus { background-color: #0f172a; color: #fff; border-color: var(--primary); }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block sidebar collapse">
                <div class="position-sticky pt-3">
                    <a class="admin-logo-container d-flex align-items-center text-white text-decoration-none" href="/">
                        <img src="/assets/images/logo/logo.png" alt="Logo" class="admin-logo me-2" />
                        <div class="admin-logo-text">
                            <span class="title">Yazılım ve Bilişim</span>
                            <span class="subtitle">Yönetim Paneli</span>
                        </div>
                    </a>
                    <ul class="nav flex-column px-2">
                        <li class="nav-item">
                            <a class="nav-link py-3 active" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2 me-2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-3" asp-area="Admin" asp-controller="Events" asp-action="Index">
                                <i class="bi bi-calendar-event me-2"></i> Etkinlikler
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-3" asp-area="Admin" asp-controller="Blogs" asp-action="Index">
                                <i class="bi bi-journal-text me-2"></i> Bloglar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-3" asp-area="Admin" asp-controller="Projects" asp-action="Index">
                                <i class="bi bi-code-slash me-2"></i> Projeler
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-3" asp-area="Admin" asp-controller="Users" asp-action="Index">
                                <i class="bi bi-people me-2"></i> Kullanıcılar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-3" asp-area="Admin" asp-controller="TeamMembers" asp-action="Index">
                                <i class="bi bi-person-badge me-2"></i> Yönetim Ekibi
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom border-secondary">
                    <h1 class="h2">@ViewData["Title"]</h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary">Dışa Aktar</button>
                        </div>
                        <a href="/" class="btn btn-sm btn-outline-primary">Siteye Dön</a>
                    </div>
                </div>

                @RenderBody()
            </main>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div class="toast show align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">@TempData["Success"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div class="toast show align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">@TempData["Error"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
