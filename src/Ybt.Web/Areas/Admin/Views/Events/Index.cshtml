@model IEnumerable<Ybt.Core.Entities.Event>
@{
    ViewData["Title"] = "Etkinlik Yönetimi";
    Layout = "_AdminLayout";
}

<div class="card p-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h5 class="mb-1 fw-bold text-white"><i class="bi bi-calendar-event text-primary me-2"></i>Etkinlikler</h5>
            <span class="text-secondary small">Topluluk atölyeleri, hackathonlar ve seminerleri yönetin.</span>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow">
            <i class="bi bi-plus-circle me-2"></i>Yeni Etkinlik Ekle
        </a>
    </div>

    <div class="table-responsive">
        <table id="eventsTable" class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Görsel & Başlık</th>
                    <th>Kategori</th>
                    <th>Tarih & Saat</th>
                    <th>Konum & Kontenjan</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Title" class="rounded-3 shadow-sm" style="width: 55px; height: 45px; object-fit: cover;">
                                }
                                <div>
                                    <span class="fw-semibold text-white d-block">@item.Title</span>
                                    <span class="text-secondary small font-monospace">@(string.IsNullOrEmpty(item.Speaker) ? "YBT Ekibi" : item.Speaker)</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-25 px-2 py-1">
                                @(string.IsNullOrEmpty(item.Category) ? "Etkinlik" : item.Category)
                            </span>
                        </td>
                        <td>
                            <span class="text-white small font-monospace d-block">
                                <i class="bi bi-calendar3 text-primary me-1"></i>@item.EventDate.ToString("dd.MM.yyyy")
                            </span>
                            <span class="text-secondary small font-monospace">
                                <i class="bi bi-clock text-info me-1"></i>@item.EventDate.ToString("HH:mm")
                            </span>
                        </td>
                        <td>
                            <span class="text-light small d-block"><i class="bi bi-geo-alt me-1 text-info"></i>@item.Location</span>
                            <span class="text-secondary small font-monospace"><i class="bi bi-people me-1 text-warning"></i>@(item.Capacity.HasValue ? $"{item.Capacity} Kişi" : "Sınırsız")</span>
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-2 py-1">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25 px-2 py-1">Pasif</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a href="/Events/Details/@item.Slug" target="_blank" class="btn btn-sm btn-outline-info rounded-pill px-2" title="Önizle">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill px-2" title="Düzenle">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2 btn-delete-confirm" 
                                        data-delete-url="@Url.Action("Delete", "Events", new { id = item.Id })"
                                        data-item-title="@item.Title"
                                        title="Sil">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#eventsTable').DataTable({
                "pageLength": 10,
                "responsive": true,
                "order": [[2, "desc"]]
            });
        });
    </script>
}
