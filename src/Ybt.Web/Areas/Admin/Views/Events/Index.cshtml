@model IEnumerable<Ybt.Core.Entities.Event>
@{
    ViewData["Title"] = "Etkinlik Yönetimi";
}

<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0">Etkinlik Listesi</h5>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i> Yeni Etkinlik</a>
    </div>
    <div class="table-responsive">
        <table id="eventsTable" class="table table-hover">
            <thead>
                <tr>
                    <th>Başlık</th>
                    <th>Tarih</th>
                    <th>Konum</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold text-white">@item.Title</td>
                        <td><span class="font-monospace">@item.EventDate.ToString("dd.MM.yyyy HH:mm")</span></td>
                        <td><small class="text-secondary"><i class="bi bi-geo-alt me-1 text-info"></i>@item.Location</small></td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25">Pasif</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                <a href="/Events/Details/@item.Slug" target="_blank" class="btn btn-sm btn-outline-info" title="Görüntüle"><i class="bi bi-eye"></i></a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu etkinliği silmek istediğinize emin misiniz?')" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-danger rounded-0 rounded-end" title="Sil"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#eventsTable').DataTable({
                "pageLength": 10,
                "responsive": true
            });
        });
    </script>
}
