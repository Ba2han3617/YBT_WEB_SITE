@model Ybt.Core.Entities.Event
@{
    ViewData["Title"] = "Yeni Etkinlik Oluştur";
    Layout = "_AdminLayout";
}

<div class="card p-4 p-md-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-25">
        <div>
            <h4 class="fw-bold text-white mb-1"><i class="bi bi-calendar-plus text-primary me-2"></i>Yeni Etkinlik Oluştur</h4>
            <span class="text-secondary small">Topluluk üyeleri için yeni bir atölye, seminer veya yarışma planlayın.</span>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i>Listeye Dön
        </a>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label text-secondary small">Etkinlik Başlığı *</label>
                    <input asp-for="Title" class="form-control rounded-pill px-3" placeholder="Örn: YBT Hackathon 2026: Yapay Zeka ve Gelecek" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Category" class="form-label text-secondary small">Etkinlik Türü / Kategori</label>
                        <select asp-for="Category" class="form-select rounded-pill px-3">
                            <option value="Hackathon">Hackathon</option>
                            <option value="Workshop & Atölye">Workshop & Atölye</option>
                            <option value="CTF & Siber Güvenlik">CTF & Siber Güvenlik</option>
                            <option value="Seminer & Konferans">Seminer & Konferans</option>
                            <option value="Sosyal Etkinlik">Sosyal Etkinlik</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Capacity" class="form-label text-secondary small">Katılımcı Kontenjanı (Kişi)</label>
                        <input asp-for="Capacity" class="form-control rounded-pill px-3" type="number" min="1" placeholder="Örn: 75 (Boş bırakılırsa sınırsız)" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Speaker" class="form-label text-secondary small">Konuşmacı / Eğitmen</label>
                        <input asp-for="Speaker" class="form-control rounded-pill px-3" placeholder="Örn: Kıdemli Yazılım Mimarı Burak Erdem" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label text-secondary small">Konum veya Çevrim İçi Bağlantı *</label>
                        <input asp-for="Location" class="form-control rounded-pill px-3" placeholder="Örn: Mühendislik Fakültesi Amfi-1 veya Google Meet" required />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label text-secondary small">Etkinlik Açıklaması *</label>
                    <textarea asp-for="Description" class="form-control px-3 py-3" rows="8" style="border-radius: 16px;" placeholder="Etkinlik kazanımları, gereksinimler, program akışı..." required></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="p-3 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-25 mb-4">
                    <h6 class="fw-bold text-white mb-3"><i class="bi bi-calendar3-event text-info me-2"></i>Zaman & Görsel</h6>

                    <div class="mb-3">
                        <label asp-for="EventDate" class="form-label text-secondary small">Etkinlik Tarihi & Saati *</label>
                        <input asp-for="EventDate" class="form-control rounded-pill px-3" type="datetime-local" required />
                        <span asp-validation-for="EventDate" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small">Etkinlik Afişi / Görseli</label>
                        <input type="file" name="imageFile" class="form-control rounded-pill px-3" accept="image/*" />
                        <small class="text-secondary d-block mt-1">Önerilen: 1200x675 piksel (Max 2MB)</small>
                    </div>

                    <div class="mb-2 pt-2 border-top border-secondary border-opacity-25">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive" class="form-check-label text-white">Yayınlansın (Aktif)</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4 pt-3 border-top border-secondary border-opacity-25">
            <button type="submit" class="btn btn-primary rounded-pill px-5 shadow">
                <i class="bi bi-check2 me-2"></i>Etkinliği Oluştur
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
