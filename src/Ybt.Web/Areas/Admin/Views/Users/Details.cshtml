@model Ybt.Core.Entities.AppUser
@{
    ViewData["Title"] = "Kullanıcı Detayı & Yetkilendirme";
    Layout = "_AdminLayout";
    var roles = ViewBag.Roles as List<string> ?? new List<string>();
    var allRoles = ViewBag.AllRoles as List<string> ?? new List<string> { "Admin", "User" };
    var currentRole = roles.FirstOrDefault() ?? "User";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h4 class="mb-1 fw-bold text-white"><i class="bi bi-person-badge text-primary me-2"></i>Kullanıcı Detayı</h4>
        <span class="text-secondary small">Kullanıcının profil bilgilerini inceleyin ve rol/yetki ayarlarını güncelleyin.</span>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-1"></i>Listeye Dön
    </a>
</div>

<div class="row g-4">
    <!-- Sol Taraf: Profil Özeti & Rol Güncelleme -->
    <div class="col-lg-4">
        <div class="card p-4 text-center mb-4">
            <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow @(currentRole == "Admin" ? "bg-warning bg-opacity-25 text-warning border border-warning" : "bg-primary bg-opacity-25 text-info border border-info")" style="width: 80px; height: 80px; font-size: 2rem;">
                @(string.IsNullOrEmpty(Model.FirstName) ? Model.UserName?[0].ToString().ToUpper() : Model.FirstName[0].ToString().ToUpper())
            </div>
            <h5 class="fw-bold text-white mb-1">@(string.IsNullOrWhiteSpace(Model.FullName) ? Model.UserName : Model.FullName)</h5>
            <span class="text-secondary small font-monospace d-block mb-3">@@@Model.UserName</span>

            <div class="mb-3">
                @if (currentRole == "Admin")
                {
                    <span class="badge bg-warning bg-opacity-25 text-warning border border-warning px-3 py-2 fs-6">
                        <i class="bi bi-shield-lock-fill me-1"></i>Sistem Yöneticisi (Admin)
                    </span>
                }
                else
                {
                    <span class="badge bg-primary bg-opacity-25 text-info border border-info px-3 py-2 fs-6">
                        <i class="bi bi-person-fill me-1"></i>Topluluk Üyesi (User)
                    </span>
                }
            </div>

            <div class="text-secondary small font-monospace border-top border-secondary border-opacity-25 pt-3">
                <i class="bi bi-calendar3 text-info me-1"></i>Kayıt: @Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")
            </div>
        </div>

        <!-- Rol Değiştirme Kartı -->
        <div class="card p-4">
            <h6 class="fw-bold text-white mb-3"><i class="bi bi-shield-shaded text-warning me-2"></i>Rol ve Yetki Güncelle</h6>
            <p class="text-secondary small mb-3">Kullanıcının sistemdeki rolünü değiştirerek Admin yetkisi verebilir veya kaldırabilirsiniz.</p>

            <form asp-action="UpdateRole" method="post" onsubmit="return confirm('Bu kullanıcının rolünü güncellemek istediğinize emin misiniz?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                
                <div class="mb-3">
                    <label class="form-label text-secondary small">Kullanıcı Rolü</label>
                    <select name="role" class="form-select rounded-pill px-3">
                        @foreach (var r in allRoles)
                        {
                            if (r == currentRole)
                            {
                                <option value="@r" selected>@r @(r == "Admin" ? "(Tam Yetkili Yönetici)" : "(Standart Üye)")</option>
                            }
                            else
                            {
                                <option value="@r">@r @(r == "Admin" ? "(Tam Yetkili Yönetici)" : "(Standart Üye)")</option>
                            }
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-warning w-100 rounded-pill shadow">
                    <i class="bi bi-check2-circle me-1"></i>Rolü Güncelle
                </button>
            </form>
        </div>
    </div>

    <!-- Sağ Taraf: Detaylı Bilgiler -->
    <div class="col-lg-8">
        <div class="card p-4 p-md-5">
            <h5 class="fw-bold text-white mb-4 pb-2 border-bottom border-secondary border-opacity-25">
                <i class="bi bi-person-vcard text-info me-2"></i>Profil & Akademik Bilgiler
            </h5>

            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <label class="text-secondary small d-block mb-1">Ad Soyad</label>
                    <span class="fw-semibold text-white">@(string.IsNullOrWhiteSpace(Model.FullName) ? "-" : Model.FullName)</span>
                </div>
                <div class="col-md-6">
                    <label class="text-secondary small d-block mb-1">E-posta Adresi</label>
                    <span class="fw-semibold text-white font-monospace">@Model.Email</span>
                </div>
                <div class="col-md-6">
                    <label class="text-secondary small d-block mb-1">Telefon Numarası</label>
                    <span class="fw-semibold text-white font-monospace">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</span>
                </div>
                <div class="col-md-6">
                    <label class="text-secondary small d-block mb-1">Öğrenci Numarası</label>
                    <span class="fw-semibold text-white font-monospace">@(string.IsNullOrWhiteSpace(Model.StudentNumber) ? "-" : Model.StudentNumber)</span>
                </div>
                <div class="col-md-6">
                    <label class="text-secondary small d-block mb-1">Fakülte / Birim</label>
                    <span class="fw-semibold text-white">@(string.IsNullOrWhiteSpace(Model.Faculty) ? "-" : Model.Faculty)</span>
                </div>
                <div class="col-md-6">
                    <label class="text-secondary small d-block mb-1">Bölüm / Program</label>
                    <span class="fw-semibold text-white">@(string.IsNullOrWhiteSpace(Model.Department) ? "-" : Model.Department)</span>
                </div>
                <div class="col-md-6">
                    <label class="text-secondary small d-block mb-1">Sınıf</label>
                    <span class="fw-semibold text-white">@(string.IsNullOrWhiteSpace(Model.Grade) ? "-" : Model.Grade)</span>
                </div>
                <div class="col-md-6">
                    <label class="text-secondary small d-block mb-1">TC Kimlik No</label>
                    <span class="fw-semibold text-white font-monospace">@(string.IsNullOrWhiteSpace(Model.TcNo) ? "-" : Model.TcNo)</span>
                </div>
            </div>

            <h5 class="fw-bold text-white mb-3 pt-3 pb-2 border-bottom border-secondary border-opacity-25">
                <i class="bi bi-globe text-primary me-2"></i>İlgi Alanları & Sosyal Bağlantılar
            </h5>

            <div class="row g-4 mb-3">
                <div class="col-12">
                    <label class="text-secondary small d-block mb-1">İlgi Alanları / Uzmanlıklar</label>
                    <span class="text-light">@(string.IsNullOrWhiteSpace(Model.Interests) ? "Belirtilmemiş" : Model.Interests)</span>
                </div>
                <div class="col-md-6">
                    <label class="text-secondary small d-block mb-1">GitHub Profili</label>
                    @if (!string.IsNullOrWhiteSpace(Model.GitHubUrl))
                    {
                        <a href="@Model.GitHubUrl" target="_blank" class="text-info text-decoration-none font-monospace">
                            <i class="bi bi-github me-1"></i>@Model.GitHubUrl
                        </a>
                    }
                    else
                    {
                        <span class="text-secondary">-</span>
                    }
                </div>
                <div class="col-md-6">
                    <label class="text-secondary small d-block mb-1">LinkedIn Profili</label>
                    @if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl))
                    {
                        <a href="@Model.LinkedInUrl" target="_blank" class="text-info text-decoration-none font-monospace">
                            <i class="bi bi-linkedin me-1"></i>@Model.LinkedInUrl
                        </a>
                    }
                    else
                    {
                        <span class="text-secondary">-</span>
                    }
                </div>
                <div class="col-12">
                    <label class="text-secondary small d-block mb-1">Adres</label>
                    <span class="text-light">@(string.IsNullOrWhiteSpace(Model.Address) ? "-" : Model.Address)</span>
                </div>
            </div>
        </div>
    </div>
</div>
