@model IEnumerable<Ybt.Core.Entities.EventApplication>
@{
    ViewData["Title"] = "Etkinlik Başvuruları Yönetimi";
    Layout = "_AdminLayout";
    var currentFilter = ViewBag.CurrentFilter as string ?? "all";
}

<!-- Filter Tabs -->
<div class="card p-3 mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" asp-route-status="all" class="btn btn-sm @(currentFilter == "all" ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3">
                Tümü <span class="badge bg-dark ms-1">@ViewBag.TotalCount</span>
            </a>
            <a asp-action="Index" asp-route-status="pending" class="btn btn-sm @(currentFilter == "pending" ? "btn-info text-white" : "btn-outline-info") rounded-pill px-3">
                Yeni Başvuru <span class="badge bg-dark ms-1">@ViewBag.PendingCount</span>
            </a>
            <a asp-action="Index" asp-route-status="reviewing" class="btn btn-sm @(currentFilter == "reviewing" ? "btn-warning text-dark" : "btn-outline-warning") rounded-pill px-3">
                Değerlendiriliyor <span class="badge bg-dark ms-1">@ViewBag.ReviewingCount</span>
            </a>
            <a asp-action="Index" asp-route-status="approved" class="btn btn-sm @(currentFilter == "approved" ? "btn-success" : "btn-outline-success") rounded-pill px-3">
                Onaylandı <span class="badge bg-dark ms-1">@ViewBag.ApprovedCount</span>
            </a>
            <a asp-action="Index" asp-route-status="rejected" class="btn btn-sm @(currentFilter == "rejected" ? "btn-danger" : "btn-outline-danger") rounded-pill px-3">
                Reddedildi <span class="badge bg-dark ms-1">@ViewBag.RejectedCount</span>
            </a>
        </div>
        <span class="text-secondary small font-monospace"><i class="bi bi-info-circle me-1"></i>Toplam @Model.Count() başvuru listeleniyor</span>
    </div>
</div>

<!-- Applications Table Card -->
<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0 fw-bold text-white"><i class="bi bi-inboxes-fill text-info me-2"></i>Başvuru Listesi</h5>
    </div>
    <div class="table-responsive">
        <table id="applicationsTable" class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Başvuran Üye</th>
                    <th>Öğrenci No</th>
                    <th>Fakülte / Bölüm</th>
                    <th>Başvurulan Etkinlik</th>
                    <th>Başvuru Tarihi</th>
                    <th>Durum</th>
                    <th class="text-end">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar bg-primary bg-opacity-20 text-info rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-weight: bold;">
                                    @(item.User?.FirstName?.Substring(0, 1) ?? "U")
                                </div>
                                <div>
                                    <span class="fw-bold text-white d-block">@(item.User?.FullName ?? (item.User?.FirstName + " " + item.User?.LastName))</span>
                                    <span class="text-secondary small">@(item.User?.Email ?? "-")</span>
                                </div>
                            </div>
                        </td>
                        <td class="font-monospace small text-info">@(item.User?.StudentNumber ?? "-")</td>
                        <td>
                            <span class="text-light small d-block">@(item.User?.Faculty ?? "Belirtilmemiş")</span>
                            <span class="text-secondary small">@(item.User?.Department ?? "-")</span>
                        </td>
                        <td>
                            <span class="fw-semibold text-white d-block">@(item.Event?.Title ?? "Silinmiş Etkinlik")</span>
                            <span class="text-secondary small font-monospace"><i class="bi bi-calendar-event me-1"></i>@(item.Event?.EventDate.ToString("dd.MM.yyyy HH:mm") ?? "-")</span>
                        </td>
                        <td class="text-secondary small font-monospace">@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (item.Status == "Onaylandı" || item.Status == "Approved")
                            {
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-2 py-1">Onaylandı</span>
                            }
                            else if (item.Status == "Değerlendiriliyor" || item.Status == "UnderReview")
                            {
                                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25 px-2 py-1">Değerlendiriliyor</span>
                            }
                            else if (item.Status == "Reddedildi" || item.Status == "Rejected")
                            {
                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25 px-2 py-1">Reddedildi</span>
                            }
                            else
                            {
                                <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-25 px-2 py-1">Yeni Başvuru</span>
                            }
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3 btn-inspect" data-app-id="@item.Id">
                                <i class="bi bi-search me-1"></i>İncele
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Application Detail & Review Modal -->
<div class="modal fade" id="applicationDetailModal" tabindex="-1" aria-labelledby="appModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card border-secondary text-white" style="background: rgba(15, 23, 42, 0.98);">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title fw-bold" id="appModalLabel">
                    <i class="bi bi-card-text text-info me-2"></i>Başvuru Detayı & Değerlendirme
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form asp-action="UpdateStatus" method="post" id="statusUpdateForm">
                <input type="hidden" name="id" id="modalAppId" />
                <input type="hidden" name="status" id="modalStatusInput" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                <div class="modal-body p-4">
                    <!-- Applicant Info -->
                    <div class="p-3 mb-4 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom border-secondary border-opacity-25 pb-2">
                            <div>
                                <h5 class="fw-bold text-white mb-0" id="modalApplicantName">-</h5>
                                <span class="text-info small" id="modalApplicantEmail">-</span>
                            </div>
                            <span class="badge px-3 py-2 fs-6 rounded-pill" id="modalStatusBadge">Yeni Başvuru</span>
                        </div>
                        <div class="row g-3 small">
                            <div class="col-md-4">
                                <span class="text-secondary d-block">Telefon:</span>
                                <strong class="text-white" id="modalApplicantPhone">-</strong>
                            </div>
                            <div class="col-md-4">
                                <span class="text-secondary d-block">Öğrenci Numarası:</span>
                                <strong class="text-white font-monospace" id="modalApplicantStudentNo">-</strong>
                            </div>
                            <div class="col-md-4">
                                <span class="text-secondary d-block">Sınıf:</span>
                                <strong class="text-white" id="modalApplicantGrade">-</strong>
                            </div>
                            <div class="col-md-6">
                                <span class="text-secondary d-block">Fakülte:</span>
                                <strong class="text-white" id="modalApplicantFaculty">-</strong>
                            </div>
                            <div class="col-md-6">
                                <span class="text-secondary d-block">Bölüm:</span>
                                <strong class="text-white" id="modalApplicantDepartment">-</strong>
                            </div>
                            <div class="col-12">
                                <span class="text-secondary d-block">İlgi Alanları & Teknolojiler:</span>
                                <strong class="text-white" id="modalApplicantInterests">-</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Event & Application Note -->
                    <div class="p-3 mb-4 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                        <div class="mb-3">
                            <span class="text-secondary small d-block">Başvurulan Etkinlik:</span>
                            <h6 class="fw-bold text-white mb-1" id="modalEventTitle">-</h6>
                            <span class="text-info small font-monospace"><i class="bi bi-calendar3 me-1"></i><span id="modalEventDate">-</span> &bull; <span id="modalEventLocation">-</span></span>
                        </div>
                        <div class="mb-2">
                            <span class="text-secondary small d-block">Kullanıcı Başvuru Notu:</span>
                            <div class="p-2 rounded bg-black bg-opacity-30 text-light small" id="modalApplicantNotes" style="min-height: 50px;">-</div>
                        </div>
                        <div>
                            <span class="text-secondary small font-monospace">Başvuru Tarihi: <span id="modalCreatedAt">-</span></span>
                        </div>
                    </div>

                    <!-- Admin Notes Input -->
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Yönetici Değerlendirme Notu / Açıklama</label>
                        <textarea name="adminNotes" id="modalAdminNotes" class="form-control px-3 py-2" rows="2" style="border-radius: 12px;" placeholder="Başvuru ile ilgili kulüp içi not veya gerekçe..."></textarea>
                    </div>
                </div>

                <!-- Action Buttons to set status directly -->
                <div class="modal-footer border-secondary border-opacity-25 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Kapat</button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-warning text-dark rounded-pill px-3" onclick="submitStatus('Değerlendiriliyor')">
                            <i class="bi bi-hourglass-split me-1"></i>Değerlendirmeye Al
                        </button>
                        <button type="button" class="btn btn-danger rounded-pill px-3" onclick="submitStatus('Reddedildi')">
                            <i class="bi bi-x-circle me-1"></i>Reddet
                        </button>
                        <button type="button" class="btn btn-success rounded-pill px-4" onclick="submitStatus('Onaylandı')">
                            <i class="bi bi-check-circle-fill me-1"></i>Onayla
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#applicationsTable').DataTable({
                "pageLength": 10,
                "responsive": true,
                "order": [[4, "desc"]]
            });

            // Inspect Button click
            $('.btn-inspect').on('click', function() {
                var appId = $(this).data('app-id');
                loadApplicationDetails(appId);
            });
        });

        function loadApplicationDetails(appId) {
            $.get('/ybt-yonetim/basvurular/GetDetails/' + appId, function(data) {
                $('#modalAppId').val(data.id);
                $('#modalApplicantName').text(data.fullName);
                $('#modalApplicantEmail').text(data.email);
                $('#modalApplicantPhone').text(data.phone);
                $('#modalApplicantStudentNo').text(data.studentNumber);
                $('#modalApplicantGrade').text(data.grade);
                $('#modalApplicantFaculty').text(data.faculty);
                $('#modalApplicantDepartment').text(data.department);
                $('#modalApplicantInterests').text(data.interests);
                $('#modalEventTitle').text(data.eventTitle);
                $('#modalEventDate').text(data.eventDate);
                $('#modalEventLocation').text(data.eventLocation);
                $('#modalApplicantNotes').text(data.notes);
                $('#modalAdminNotes').val(data.adminNotes);
                $('#modalCreatedAt').text(data.createdAt);

                var badge = $('#modalStatusBadge');
                badge.removeClass('bg-info bg-warning bg-success bg-danger text-dark text-white');
                badge.text(data.status);

                if (data.status === 'Onaylandı' || data.status === 'Approved') {
                    badge.addClass('bg-success text-white');
                } else if (data.status === 'Değerlendiriliyor' || data.status === 'UnderReview') {
                    badge.addClass('bg-warning text-dark');
                } else if (data.status === 'Reddedildi' || data.status === 'Rejected') {
                    badge.addClass('bg-danger text-white');
                } else {
                    badge.addClass('bg-info text-white');
                }

                var modal = new bootstrap.Modal(document.getElementById('applicationDetailModal'));
                modal.show();
            }).fail(function() {
                alert('Başvuru detayları yüklenirken bir hata oluştu.');
            });
        }

        function submitStatus(newStatus) {
            $('#modalStatusInput').val(newStatus);
            $('#statusUpdateForm').submit();
        }
    </script>
}
