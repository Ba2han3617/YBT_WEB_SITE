@model IEnumerable<Ybt.Core.Entities.TeamMember>
@{
    ViewData["Title"] = "Yönetim Ekibi Yönetimi";
    Layout = "_AdminLayout";
}

<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0">Yönetim Ekibi</h5>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i> Yeni Üye Ekle</a>
    </div>
    <div class="table-responsive">
        <table id="teamTable" class="table table-hover">
            <thead>
                <tr>
                    <th>Sıra</th>
                    <th>Ad Soyad</th>
                    <th>Görev</th>
                    <th>Görsel Yolu</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Order</td>
                        <td>@item.FullName</td>
                        <td>@item.Role</td>
                        <td><small class="text-truncate d-inline-block" style="max-width: 180px;">@item.ImageUrl</small></td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Pasif</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Silmek istediğinize emin misiniz?')">
                                    <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#teamTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json"
                }
            });
        });
    </script>
}
